<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Unit 14 Online Practice</title>
<style>
:root{--bg1:#061b2d;--bg2:#111b4a;--card:#10213c;--stroke:rgba(255,255,255,.12);--text:#f2f6ff;--muted:rgba(242,246,255,.72);--good:#45f08d;--bad:#ff6b6b;--warn:#ffd36b;--btn:#1c3154;--btnHover:#24406d;--shadow:0 18px 55px rgba(0,0,0,.38)}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:"Century Gothic","Tw Cen MT","Trebuchet MS",Arial,sans-serif;color:var(--text);background:radial-gradient(900px 500px at 8% 0%,rgba(72,199,255,.16),transparent 60%),radial-gradient(900px 500px at 90% 10%,rgba(132,96,255,.18),transparent 60%),linear-gradient(135deg,var(--bg1),var(--bg2));padding:44px 24px}
.wrap{width:min(1280px,96vw);margin:0 auto}
.topbar{background:rgba(255,255,255,.07);border:1px solid var(--stroke);border-radius:28px;padding:20px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px;box-shadow:var(--shadow);backdrop-filter:blur(10px)}
.brand{display:flex;align-items:center;gap:16px}.logo{width:58px;height:58px;border-radius:18px;background:rgba(72,199,255,.13);border:1px solid rgba(72,199,255,.2);display:flex;align-items:center;justify-content:center;font-size:32px;overflow:hidden}.logo img{width:100%;height:100%;object-fit:contain;padding:8px}.titleblock h1{margin:0;font-size:clamp(24px,3vw,38px);letter-spacing:.3px}.titleblock .sub{margin-top:5px;color:var(--muted);font-size:16px}.stats{display:flex;gap:12px;flex-wrap:wrap;justify-content:flex-end}.pill{padding:11px 16px;border-radius:999px;background:rgba(255,255,255,.10);border:1px solid var(--stroke);color:var(--muted);font-size:15px}.pill strong{color:var(--text)}
.grid{margin-top:20px;display:grid;grid-template-columns:1.8fr 1fr;gap:20px}@media(max-width:900px){.grid{grid-template-columns:1fr}.topbar{flex-direction:column;align-items:flex-start}}
.card{background:rgba(16,33,60,.78);border:1px solid var(--stroke);border-radius:24px;box-shadow:var(--shadow);overflow:hidden}.cardHeader{padding:20px 22px 16px;border-bottom:1px solid var(--stroke)}.kicker{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.sectionLabel{display:inline-flex;align-items:center;padding:9px 16px;border-radius:999px;background:rgba(72,199,255,.12);border:1px solid rgba(72,199,255,.28);color:var(--text);font-size:16px;font-weight:700}.qMeta{color:var(--muted);font-size:15px}
.hintBox{padding:16px 18px;border-radius:18px;background:rgba(0,0,0,.16);border:1px solid rgba(255,255,255,.10);color:var(--muted);line-height:1.35}.hintBox ul{margin:10px 0 0;padding-left:20px}
.qText{padding:24px 24px 8px;border-bottom:1px solid rgba(255,255,255,.08)}.prompt{color:var(--muted);text-transform:uppercase;letter-spacing:1.4px;font-size:15px;margin-bottom:10px}.main{font-size:24px;line-height:1.4}
.speakArea{padding:12px 24px 10px}.speakBtn{border:1px solid rgba(72,199,255,.35);background:rgba(72,199,255,.13);color:var(--text);padding:10px 16px;border-radius:999px;cursor:pointer;font-weight:700}.speakBtn:hover{background:rgba(72,199,255,.20)}
.options{padding:12px 24px 24px;display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:560px){.options{grid-template-columns:1fr}}
.optBtn{text-align:left;padding:17px 18px;border-radius:18px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);color:var(--text);font-size:17px;font-weight:700;cursor:pointer;transition:.12s ease}.optBtn:hover{transform:translateY(-1px);background:rgba(255,255,255,.10)}.optBtn:disabled{cursor:default;opacity:.8;transform:none}
.feedback{padding:0 24px 14px;min-height:40px;color:var(--muted);font-size:16px}.feedback.good{color:var(--good)}.feedback.bad{color:var(--bad)}.feedback.warn{color:var(--warn)}
.controls{padding:12px 24px 24px;display:flex;justify-content:space-between;align-items:center;gap:12px}.leftControls{display:flex;gap:10px;flex-wrap:wrap}.btn{border:1px solid rgba(255,255,255,.15);background:var(--btn);color:var(--text);padding:13px 18px;border-radius:999px;cursor:pointer;font-size:15px;font-weight:700}.btn:hover{background:var(--btnHover)}.btn.primary{background:rgba(72,199,255,.13);border-color:rgba(72,199,255,.30)}.btn:disabled{opacity:.48;cursor:default}
.side{padding:22px}.side h3{margin:0 0 14px;font-size:22px}.tag{font-size:12px;color:var(--muted);border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);padding:5px 10px;border-radius:999px;margin-left:8px}.small{color:var(--muted);font-size:16px;line-height:1.5;margin-bottom:14px}.divider{height:1px;background:rgba(255,255,255,.12);margin:18px 0}
.unscrambleBox{padding:12px 24px 24px}.answerSlots{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 18px}.slot{min-width:34px;height:42px;border-radius:10px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:800;color:var(--text)}
.letterBank{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0 18px}.letterBtn{min-width:44px;height:44px;border-radius:14px;border:1px solid rgba(72,199,255,.35);background:rgba(72,199,255,.13);color:var(--text);font-size:20px;font-weight:900;cursor:pointer}.letterBtn:hover{background:rgba(72,199,255,.22)}.letterBtn:disabled{opacity:.25;cursor:default}.unscrambleControls{display:flex;gap:10px;flex-wrap:wrap}
</style>
</head>
<body>
<div class="wrap">
<div class="topbar">
<div class="brand"><div class="logo"><img src="logo.png" alt="GA Logo" onerror="this.style.display='none';this.parentElement.textContent='📰';"></div><div class="titleblock"><h1>Unit 14 – Online Practice</h1><div class="sub">Listening Vocabulary + Context + Click Unscramble + Grammar + Synonyms</div></div></div>
<div class="stats"><div class="pill">Progress: <strong id="progress">1/29</strong></div><div class="pill">Score: <strong id="score">0</strong></div><div class="pill">Mode: <strong id="mode">Main</strong></div></div>
</div>
<div class="grid">
<div class="card">
<div class="cardHeader"><div class="kicker"><div class="sectionLabel" id="sectionLabel">Part: Listening Vocabulary</div><div class="qMeta" id="qMeta">Question 1 of 29</div></div><div class="hintBox"><strong>How to play:</strong><ul><li><strong>Listening:</strong> click Listen. You will hear the definition only.</li><li><strong>Unscramble:</strong> click letters to build the word. Use Undo if you make a mistake.</li><li>If you choose the wrong answer, try again. After two mistakes, the answer will be shown.</li></ul></div></div>
<div class="qText"><div class="prompt" id="promptLine">Listening Vocabulary</div><div class="main" id="questionText"></div></div>
<div class="speakArea"><button class="speakBtn" id="speakBtn">🔊 Listen</button></div>
<div class="options" id="options"></div><div class="unscrambleBox" id="unscrambleBox" style="display:none;"></div><div class="feedback" id="feedback"></div>
<div class="controls"><div class="leftControls"><button class="btn" id="restartBtn">Restart</button><button class="btn" id="hintBtn">Hint</button></div><button class="btn primary" id="nextBtn" disabled>Next</button></div>
</div>
<div class="card"><div class="side"><h3>Unit 14 <span class="tag">News</span></h3><div class="small">Complete all activities:<br><br>• Listening Vocabulary<br>• Words in Context<br>• Click Unscramble<br>• Grammar Practice<br>• Synonyms<br><br>Wrong answer? Try again. After two mistakes, the answer will be shown.</div><div class="divider"></div><div class="small"><strong>Reading Skill:</strong><br>Conflict & Resolution<br><br><strong>Grammar:</strong><br>Present Perfect<br><br><strong>Word Study:</strong><br>Synonyms</div></div></div>
</div>
</div>
<script>
const questions=[
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'A person who gathers information and writes news stories for newspapers, television, or websites.',text:'Click Listen. Then choose the correct word.',options:['reporter','editor','headline','website'],answer:0,hint:'This person writes news stories.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'A person who checks and improves articles before they are published.',text:'Click Listen. Then choose the correct word.',options:['interview','editor','reporter','discuss'],answer:1,hint:'This person checks writing before it is published.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'A meeting where someone asks questions to get information.',text:'Click Listen. Then choose the correct word.',options:['investigate','website','interview','headline'],answer:2,hint:'A reporter often does this.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'The title of a news story that tells readers what the article is about.',text:'Click Listen. Then choose the correct word.',options:['editor','hero','headline','reporter'],answer:2,hint:'It is the title of a news story.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'A person who does something brave or helpful for others.',text:'Click Listen. Then choose the correct word.',options:['hero','reporter','discuss','website'],answer:0,hint:'This person helps others bravely.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'A place on the Internet where people can find information.',text:'Click Listen. Then choose the correct word.',options:['headline','website','mistake','editor'],answer:1,hint:'You visit this on the Internet.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'Something incorrect that you do by accident.',text:'Click Listen. Then choose the correct word.',options:['mistake','discuss','investigate','decide'],answer:0,hint:'It is an error.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'To make a choice after thinking about something.',text:'Click Listen. Then choose the correct word.',options:['decide','discuss','search','interview'],answer:0,hint:'It means to choose.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'To talk about an idea or topic with other people.',text:'Click Listen. Then choose the correct word.',options:['investigate','discuss','decide','headline'],answer:1,hint:'It means to talk about something.'},
{type:'choice',section:'Listening Vocabulary',prompt:'Listen and choose the correct word.',speech:'To carefully look for facts and information about something.',text:'Click Listen. Then choose the correct word.',options:['reporter','investigate','website','hero'],answer:1,hint:'A reporter may do this to find facts.'},
{type:'choice',section:'Words in Context',prompt:'Choose the word that best completes the sentence.',speech:'',text:'The Martins lived in a large ______.',options:['fair','mansion','donated','terrible'],answer:1,hint:'It means a very large house.'},
{type:'choice',section:'Words in Context',prompt:'Choose the word that best completes the sentence.',speech:'',text:'The family ______ money to help build the library.',options:['discussed','searched','donated','decided'],answer:2,hint:'It means gave something to help.'},
{type:'choice',section:'Words in Context',prompt:'Choose the word that best completes the sentence.',speech:'',text:'The fire was ______ and burned down the building.',options:['fair','terrible','special','entire'],answer:1,hint:'It means very bad.'},
{type:'choice',section:'Words in Context',prompt:'Choose the word that best completes the sentence.',speech:'',text:'It is only ______ to let Miss Lu stay in her home.',options:['fair','mansion','investigate','website'],answer:0,hint:'It means right or just.'},
{type:'unscramble',section:'Click Unscramble',prompt:'Click letters to build the word.',speech:'',text:'Elsa had to ______ several people to learn about the old house.',scrambled:['T','I','N','E','R','V','W','I','E'],answerWord:'INTERVIEW',hint:'A reporter asks questions during an interview.'},
{type:'unscramble',section:'Click Unscramble',prompt:'Click letters to build the word.',speech:'',text:"The newspaper's ______ caught everyone's attention.",scrambled:['H','E','A','D','L','I','N','E'],answerWord:'HEADLINE',hint:'It is the title of a news story.'},
{type:'unscramble',section:'Click Unscramble',prompt:'Click letters to build the word.',speech:'',text:'The young ______ wrote a story about Miss Lu.',scrambled:['R','E','P','O','R','T','E','R'],answerWord:'REPORTER',hint:'This person writes news stories.'},
{type:'unscramble',section:'Click Unscramble',prompt:'Click letters to build the word.',speech:'',text:'The city will ______ what to do with the building.',scrambled:['D','E','C','I','D','E'],answerWord:'DECIDE',hint:'It means make a choice.'},
{type:'unscramble',section:'Click Unscramble',prompt:'Click letters to build the word.',speech:'',text:"Elsa wanted to ______ the mansion's history.",scrambled:['I','N','V','E','S','T','I','G','A','T','E'],answerWord:'INVESTIGATE',hint:'It means carefully look for facts.'},
{type:'choice',section:'Grammar',prompt:'Choose the correct present perfect sentence.',speech:'',text:'Elsa ______ a blog about local news.',options:['has started','started','start','starting'],answer:0,hint:'Use has + past participle.'},
{type:'choice',section:'Grammar',prompt:'Choose the correct present perfect sentence.',speech:'',text:'I ______ a reporter before.',options:["haven't met","didn't met",'not meet',"don't met"],answer:0,hint:'Use have not + past participle.'},
{type:'choice',section:'Grammar',prompt:'Choose the correct present perfect sentence.',speech:'',text:'The mayor ______ the article.',options:['has read','reads','reading','readed'],answer:0,hint:'Use has + past participle.'},
{type:'choice',section:'Grammar',prompt:'Choose the correct present perfect sentence.',speech:'',text:'They ______ many stories this year.',options:['have investigated','investigated','investigates','investigating'],answer:0,hint:'Use have + past participle.'},
{type:'choice',section:'Grammar',prompt:'Choose the correct present perfect sentence.',speech:'',text:'She ______ several interviews for the newspaper.',options:['has done','did','do','doing'],answer:0,hint:'Use has + past participle.'},
{type:'choice',section:'Synonyms',prompt:'Choose the synonym.',speech:'',text:'terrible =',options:['awful','happy','tiny','quiet'],answer:0,hint:'It means very bad.'},
{type:'choice',section:'Synonyms',prompt:'Choose the synonym.',speech:'',text:'huge =',options:['little','immense','fair','quick'],answer:1,hint:'It means very big.'},
{type:'choice',section:'Synonyms',prompt:'Choose the synonym.',speech:'',text:'special =',options:['usual','ordinary','unusual','common'],answer:2,hint:'It means not ordinary.'},
{type:'choice',section:'Synonyms',prompt:'Choose the synonym.',speech:'',text:'entire =',options:['part','whole','half','piece'],answer:1,hint:'It means all of something.'},
{type:'choice',section:'Synonyms',prompt:'Choose the synonym.',speech:'',text:'mistake =',options:['error','success','victory','answer'],answer:0,hint:'It means something incorrect.'}
];

let index=0,score=0,allowNext=false,attemptCount=0,selectedLetters=[],usedLetterIndexes=[];
const progressEl=document.getElementById('progress'),scoreEl=document.getElementById('score'),modeEl=document.getElementById('mode'),sectionLabelEl=document.getElementById('sectionLabel'),qMetaEl=document.getElementById('qMeta'),promptLineEl=document.getElementById('promptLine'),questionTextEl=document.getElementById('questionText'),optionsEl=document.getElementById('options'),unscrambleBox=document.getElementById('unscrambleBox'),feedbackEl=document.getElementById('feedback'),nextBtn=document.getElementById('nextBtn'),restartBtn=document.getElementById('restartBtn'),hintBtn=document.getElementById('hintBtn'),speakBtn=document.getElementById('speakBtn');
function currentQuestion(){return questions[index]}
function setStats(){progressEl.textContent=`${index+1}/${questions.length}`;scoreEl.textContent=score;modeEl.textContent='Main'}
let speechVoices=[];function loadVoices(){speechVoices=window.speechSynthesis?window.speechSynthesis.getVoices():[]}loadVoices();if(window.speechSynthesis&&'onvoiceschanged'in window.speechSynthesis){window.speechSynthesis.onvoiceschanged=loadVoices}
function pickAmericanVoice(){if(!speechVoices||!speechVoices.length)return null;return speechVoices.find(v=>/Google US English/i.test(v.name))||speechVoices.find(v=>/Microsoft Aria/i.test(v.name))||speechVoices.find(v=>/Jenny/i.test(v.name)&&/en-US/i.test(v.lang))||speechVoices.find(v=>/Guy/i.test(v.name)&&/en-US/i.test(v.lang))||speechVoices.find(v=>/Samantha/i.test(v.name))||speechVoices.find(v=>/^en-US$/i.test(v.lang))||null}
function speakText(txt){if(!window.speechSynthesis||!txt)return;loadVoices();window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(txt);const voice=pickAmericanVoice();if(voice)u.voice=voice;u.lang='en-US';u.rate=.82;u.pitch=1.0;u.volume=1;window.speechSynthesis.speak(u)}
function render(){const q=currentQuestion();attemptCount=0;selectedLetters=[];usedLetterIndexes=[];allowNext=false;nextBtn.disabled=true;sectionLabelEl.textContent=`Part: ${q.section}`;qMetaEl.textContent=`Question ${index+1} of ${questions.length}`;promptLineEl.textContent=q.section.toUpperCase();questionTextEl.innerHTML=`<div class="prompt">${q.prompt}</div><div class="main">${q.text}</div>`;feedbackEl.className='feedback';feedbackEl.textContent='';optionsEl.innerHTML='';unscrambleBox.innerHTML='';unscrambleBox.style.display='none';if(q.type==='unscramble'){speakBtn.style.display='none';renderUnscramble()}else{speakBtn.style.display=q.speech?'inline-block':'none';speakBtn.onclick=()=>speakText(q.speech);renderChoices()}setStats()}
function renderChoices(){const q=currentQuestion();optionsEl.style.display='grid';q.options.forEach((opt,i)=>{const b=document.createElement('button');b.className='optBtn';b.textContent=opt;b.onclick=()=>choose(i);optionsEl.appendChild(b)})}
function choose(i){const q=currentQuestion(),buttons=[...optionsEl.children];if(i===q.answer){buttons.forEach(b=>b.disabled=true);score++;feedbackEl.className='feedback good';feedbackEl.textContent='Correct. Good work. Click Next.';allowNext=true;nextBtn.disabled=false;buttons[i].style.borderColor='rgba(69,240,141,.85)';buttons[i].style.background='rgba(69,240,141,.13)';setStats()}else{attemptCount++;buttons[i].disabled=true;buttons[i].style.opacity='0.42';buttons[i].style.borderColor='rgba(255,107,107,.75)';buttons[i].style.background='rgba(255,107,107,.12)';if(attemptCount>=2){const correct=buttons[q.answer];correct.style.borderColor='rgba(69,240,141,.85)';correct.style.background='rgba(69,240,141,.13)';buttons.forEach(b=>b.disabled=true);feedbackEl.className='feedback good';feedbackEl.textContent=`The answer is: ${q.options[q.answer]}. Click Next.`;allowNext=true;nextBtn.disabled=false}else{feedbackEl.className='feedback bad';feedbackEl.textContent=`Try again. Hint: ${q.hint}`}}}
function renderUnscramble(){const q=currentQuestion();optionsEl.style.display='none';unscrambleBox.style.display='block';const slots=document.createElement('div');slots.className='answerSlots';for(let i=0;i<q.answerWord.length;i++){const s=document.createElement('div');s.className='slot';s.textContent=selectedLetters[i]||'';slots.appendChild(s)}const bank=document.createElement('div');bank.className='letterBank';q.scrambled.forEach((letter,i)=>{const b=document.createElement('button');b.className='letterBtn';b.textContent=letter;b.disabled=usedLetterIndexes.includes(i);b.onclick=()=>pickLetter(letter,i);bank.appendChild(b)});const controls=document.createElement('div');controls.className='unscrambleControls';const undo=document.createElement('button');undo.className='btn';undo.textContent='↩ Undo Last Letter';undo.onclick=undoLetter;const clear=document.createElement('button');clear.className='btn';clear.textContent='🗑 Clear All';clear.onclick=clearLetters;const check=document.createElement('button');check.className='btn primary';check.textContent='Check Answer';check.onclick=checkUnscramble;controls.append(undo,clear,check);unscrambleBox.append(slots,bank,controls)}
function refreshUnscramble(){unscrambleBox.innerHTML='';renderUnscramble()}
function pickLetter(letter,i){const q=currentQuestion();if(usedLetterIndexes.includes(i)||selectedLetters.length>=q.answerWord.length)return;selectedLetters.push(letter);usedLetterIndexes.push(i);refreshUnscramble()}
function undoLetter(){if(!selectedLetters.length)return;selectedLetters.pop();usedLetterIndexes.pop();refreshUnscramble()}
function clearLetters(){selectedLetters=[];usedLetterIndexes=[];refreshUnscramble()}
function checkUnscramble(){const q=currentQuestion(),answer=selectedLetters.join('');if(answer===q.answerWord){score++;feedbackEl.className='feedback good';feedbackEl.textContent='Correct. Good work. Click Next.';allowNext=true;nextBtn.disabled=false;[...unscrambleBox.querySelectorAll('button')].forEach(b=>b.disabled=true);setStats()}else{attemptCount++;if(attemptCount>=2){selectedLetters=q.answerWord.split('');usedLetterIndexes=[...Array(q.answerWord.length).keys()];refreshUnscramble();feedbackEl.className='feedback good';feedbackEl.innerHTML=`The answer is: <strong>${q.answerWord}</strong>. Click Next.`;allowNext=true;nextBtn.disabled=false;[...unscrambleBox.querySelectorAll('button')].forEach(b=>b.disabled=true)}else{feedbackEl.className='feedback bad';feedbackEl.textContent=`Try again. Clue: ${q.hint}`}}}
function next(){if(!allowNext)return;index++;if(index<questions.length)render();else finish()}
function finish(){sectionLabelEl.textContent='Finished';qMetaEl.textContent='All done';promptLineEl.textContent='SUMMARY';questionTextEl.innerHTML=`<div class="main">You finished Unit 14.<br><br><strong>Your score:</strong> ${score} / ${questions.length}.<br><br><strong>Great work.</strong></div>`;optionsEl.innerHTML='';unscrambleBox.innerHTML='';feedbackEl.textContent='';nextBtn.disabled=true;speakBtn.style.display='none'}
function restart(){index=0;score=0;allowNext=false;attemptCount=0;selectedLetters=[];usedLetterIndexes=[];render()}
nextBtn.addEventListener('click',next);restartBtn.addEventListener('click',restart);hintBtn.addEventListener('click',()=>{const q=currentQuestion();feedbackEl.className='feedback warn';feedbackEl.textContent=`Hint: ${q.hint}`});render();
</script>
</body>
</html>
